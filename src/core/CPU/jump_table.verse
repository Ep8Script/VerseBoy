OpcodeMap <internal> : [int]type{func(:emulator):void} = map:
    # No-op
    0x0 => Opcode0x0

    # 8-bit loads
    0x06 => Opcode0x06
    0x0E => Opcode0x0E
    0x16 => Opcode0x16
    0x1E => Opcode0x1E
    0x26 => Opcode0x26
    0x2E => Opcode0x2E

    # Load reg
    0x7F => Opcode0x7F
    0x78 => Opcode0x78
    0x79 => Opcode0x79
    0x7A => Opcode0x7A
    0x7B => Opcode0x7B
    0x7C => Opcode0x7C
    0x7D => Opcode0x7D
    0x40 => Opcode0x40
    0x41 => Opcode0x41
    0x42 => Opcode0x42
    0x43 => Opcode0x43
    0x44 => Opcode0x44
    0x45 => Opcode0x45
    0x48 => Opcode0x48
    0x49 => Opcode0x49
    0x4A => Opcode0x4A
    0x4B => Opcode0x4B
    0x4C => Opcode0x4C
    0x4D => Opcode0x4D
    0x50 => Opcode0x50
    0x51 => Opcode0x51
    0x52 => Opcode0x52
    0x53 => Opcode0x53
    0x54 => Opcode0x54
    0x55 => Opcode0x55
    0x58 => Opcode0x58
    0x59 => Opcode0x59
    0x5A => Opcode0x5A
    0x5B => Opcode0x5B
    0x5C => Opcode0x5C
    0x5D => Opcode0x5D
    0x60 => Opcode0x60
    0x61 => Opcode0x61
    0x62 => Opcode0x62
    0x63 => Opcode0x63
    0x64 => Opcode0x64
    0x65 => Opcode0x65
    0x68 => Opcode0x68
    0x69 => Opcode0x69
    0x6A => Opcode0x6A
    0x6B => Opcode0x6B
    0x6C => Opcode0x6C
    0x6D => Opcode0x6D

    # Write reg to memory
    0x70 => Opcode0x70
    0x71 => Opcode0x71
    0x72 => Opcode0x72
    0x73 => Opcode0x73
    0x74 => Opcode0x74
    0x75 => Opcode0x75

    # Write memory to reg
    0x7E => Opcode0x7E
    0x46 => Opcode0x46
    0x4E => Opcode0x4E
    0x56 => Opcode0x56
    0x5E => Opcode0x5E
    0x66 => Opcode0x66
    0x6E => Opcode0x6E
    0x0A => Opcode0x0A
    0x1A => Opcode0x1A
    0xF2 => Opcode0xF2

    # Put a into register
    0x47 => Opcode0x47
    0x4F => Opcode0x4F
    0x57 => Opcode0x57
    0x5F => Opcode0x5F
    0x67 => Opcode0x67
    0x6F => Opcode0x6F

    # Put a into memory address
    0x02 => Opcode0x02
    0x12 => Opcode0x12
    0x77 => Opcode0x77
    0xE2 => Opcode0xE2

    # Put memory into a, decrement/increment memory
    0x3A => Opcode0x3A
    0x2A => Opcode0x2A

    # Put a into memory, decrement/increment reg
    0x32 => Opcode0x32
    0x22 => Opcode0x22

    # 16 bit loads
    0x01 => Opcode0x01
    0x11 => Opcode0x11
    0x21 => Opcode0x21
    0x31 => Opcode0x31
    0xF9 => Opcode0xF9

    # Push word onto stack
    0xF5 => Opcode0xF5
    0xC5 => Opcode0xC5
    0xD5 => Opcode0xD5
    0xE5 => Opcode0xE5

    # Pop word from stack into reg
    0xF1 => Opcode0xF1
    0xC1 => Opcode0xC1
    0xD1 => Opcode0xD1
    0xE1 => Opcode0xE1

    # 8-bit add
    0x87 => Opcode0x87
    0x80 => Opcode0x80
    0x81 => Opcode0x81
    0x82 => Opcode0x82
    0x83 => Opcode0x83
    0x84 => Opcode0x84
    0x85 => Opcode0x85
    0x86 => Opcode0x86
    0xC6 => Opcode0xC6

    # 8-bit add + carry
    0x8F => Opcode0x8F
    0x88 => Opcode0x88
    0x89 => Opcode0x89
    0x8A => Opcode0x8A
    0x8B => Opcode0x8B
    0x8C => Opcode0x8C
    0x8D => Opcode0x8D
    0x8E => Opcode0x8E
    0xCE => Opcode0xCE

    # 8-bit subtract
    0x97 => Opcode0x97
    0x90 => Opcode0x90
    0x91 => Opcode0x91
    0x92 => Opcode0x92
    0x93 => Opcode0x93
    0x94 => Opcode0x94
    0x95 => Opcode0x95
    0x96 => Opcode0x96
    0xD6 => Opcode0xD6

    # 8-bit subtract + carry
    0x9F => Opcode0x9F
    0x98 => Opcode0x98
    0x99 => Opcode0x99
    0x9A => Opcode0x9A
    0x9B => Opcode0x9B
    0x9C => Opcode0x9C
    0x9D => Opcode0x9D
    0x9E => Opcode0x9E
    0xDE => Opcode0xDE

    # 8-bit AND reg with reg
    0xA7 => Opcode0xA7
    0xA0 => Opcode0xA0
    0xA1 => Opcode0xA1
    0xA2 => Opcode0xA2
    0xA3 => Opcode0xA3
    0xA4 => Opcode0xA4
    0xA5 => Opcode0xA5
    0xA6 => Opcode0xA6
    0xE6 => Opcode0xE6

    # 8-bit OR reg with reg
    0xB7 => Opcode0xB7
    0xB0 => Opcode0xB0
    0xB1 => Opcode0xB1
    0xB2 => Opcode0xB2
    0xB3 => Opcode0xB3
    0xB4 => Opcode0xB4
    0xB5 => Opcode0xB5
    0xB6 => Opcode0xB6
    0xF6 => Opcode0xF6

    # 8-bit XOR reg with reg
    0xAF => Opcode0xAF
    0xA8 => Opcode0xA8
    0xA9 => Opcode0xA9
    0xAA => Opcode0xAA
    0xAB => Opcode0xAB
    0xAC => Opcode0xAC
    0xAD => Opcode0xAD
    0xAE => Opcode0xAE
    0xEE => Opcode0xEE

    # 8-Bit compare
    0xBF => Opcode0xBF
    0xB8 => Opcode0xB8
    0xB9 => Opcode0xB9
    0xBA => Opcode0xBA
    0xBB => Opcode0xBB
    0xBC => Opcode0xBC
    0xBD => Opcode0xBD
    0xBE => Opcode0xBE
    0xFE => Opcode0xFE

    # 8-bit inc
    0x3C => Opcode0x3C
    0x04 => Opcode0x04
    0x0C => Opcode0x0C
    0x14 => Opcode0x14
    0x1C => Opcode0x1C
    0x24 => Opcode0x24
    0x2C => Opcode0x2C
    0x34 => Opcode0x34

    # 8-bit dec
    0x3D => Opcode0x3D
    0x05 => Opcode0x05
    0x0D => Opcode0x0D
    0x15 => Opcode0x15
    0x1D => Opcode0x1D
    0x25 => Opcode0x25
    0x2D => Opcode0x2D
    0x35 => Opcode0x35

    # 16-bit add
    0x09 => Opcode0x09
    0x19 => Opcode0x19
    0x29 => Opcode0x29
    0x39 => Opcode0x39

    # Inc 16-bit register
    0x03 => Opcode0x03
    0x13 => Opcode0x13
    0x23 => Opcode0x23
    0x33 => Opcode0x33

    # Dec 16-bit register
    0x0B => Opcode0x0B
    0x1B => Opcode0x1B
    0x2B => Opcode0x2B
    0x3B => Opcode0x3B

    # Jumps
    0xE9 => Opcode0xE9
    0xC3 => Opcode0xC3
    0xC2 => Opcode0xC2
    0xCA => Opcode0xCA
    0xD2 => Opcode0xD2
    0xDA => Opcode0xDA

    # Jump with immediate data
    0x18 => Opcode0x18
    0x20 => Opcode0x20
    0x28 => Opcode0x28
    0x30 => Opcode0x30
    0x38 => Opcode0x38

    # Calls
    0xCD => Opcode0xCD
    0xC4 => Opcode0xC4
    0xCC => Opcode0xCC
    0xD4 => Opcode0xD4
    0xDC => Opcode0xDC

    # Returns
    0xC9 => Opcode0xC9
    0xC0 => Opcode0xC0
    0xC8 => Opcode0xC8
    0xD0 => Opcode0xD0
    0xD8 => Opcode0xD8

    # Restarts
    0xC7 => Opcode0xC7
    0xCF => Opcode0xCF
    0xD7 => Opcode0xD7
    0xDF => Opcode0xDF
    0xE7 => Opcode0xE7
    0xEF => Opcode0xEF
    0xF7 => Opcode0xF7
    0xFF => Opcode0xFF

    0x27 => Opcode0x27

    # Handle the extended opcodes
    0xCB => Opcode0xCB

    # Unique instructions
    0x07 => Opcode0x07
    0x0F => Opcode0x0F
    0x17 => Opcode0x17
    0x1F => Opcode0x1F

    0xD9 => Opcode0xD9
    0x08 => Opcode0x08
    0x36 => Opcode0x36
    0xFA => Opcode0xFA
    0x3E => Opcode0x3E
    0xEA => Opcode0xEA
    0xF3 => Opcode0xF3
    0xFB => Opcode0xFB
    0xE0 => Opcode0xE0
    0xF0 => Opcode0xF0
    0x2F => Opcode0x2F
    0x76 => Opcode0x76
    0x3F => Opcode0x3F
    0x37 => Opcode0x37
    0xF8 => Opcode0xF8
    0x10 => Opcode0x10
    0xE8 => Opcode0xE8

    # Illegal
    0xD3 => Stub
    0xDB => Stub
    0xDD => Stub
    0xE3 => Stub
    0xE4 => Stub
    0xEB => Stub
    0xEC => Stub
    0xED => Stub
    0xF4 => Stub
    0xFC => Stub
    0xFD => Stub

# Stub is never reached here, but for some reason module-scoped arrays don't allow failure
ExtendedOpcodes <internal> : []type{func(:emulator):void} = for (Index := 0..ExtendedOpcodeMap.Length - 1) do ExtendedOpcodeMap[Index] or Stub
Opcodes <internal> : []type{func(:emulator):void} = for (Index := 0..OpcodeMap.Length - 1) do OpcodeMap[Index] or Stub

Stub<internal>(Emulator:emulator):false=
    Err()